<section class="cta-band">
  <div class="wrap cta-in" data-reveal>
    <div>
      <h2><%= t('cta.title') %></h2>
      <p><%= t('cta.text') %></p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-light btn-lg" href="tel:<%= site.phoneIntl %>"><svg class="ic"><use href="#i-phone"/></svg><%= t('cta.call') %> <%= site.phoneDisplay %></a>
      <a class="btn btn-ghost-light btn-lg" href="<%= site.zalo %>" target="_blank" rel="noopener"><svg class="ic"><use href="#i-msg"/></svg><%= t('cta.zalo') %></a>
    </div>
  </div>
</section>
